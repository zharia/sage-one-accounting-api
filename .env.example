# Application-level environment variables for examples and live tests.
# Copy to `.env` (gitignored). The SDK itself never reads these — your app does.
# Never commit real credentials.

# Sage One login username
SAGE_USERNAME=

# Sage One login password
SAGE_PASSWORD=

# Company context (type confirmed during M002 discovery)
SAGE_COMPANY_ID=

# Override API base URL (tests, proxies). Empty = production default.
SAGE_BASE_URL=

# Set to `true` ONLY to run tests/live (opt-in; never in ordinary CI)
SAGE_LIVE_TESTS=false
